# ⚡ ВАЖНО: Игнорируем старые API файлы
# Vercel считает каждый .js файл в /api отдельной функцией
# Мы оставляем только router.js, остальное перенесено в /lib

# Игнорируем все файлы в api/ кроме router.js
api/*.js
!api/router.js

# Также игнорируем вспомогательные файлы
api/handlers/
api/index.js
api/data.js
