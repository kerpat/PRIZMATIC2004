# ============================================
# PRIZMATIC Environment Variables
# ============================================
# Rename this file to .env for local development
# For Vercel: add these variables in Dashboard → Settings → Environment Variables

# ============================================
# WEBAPP URL
# ============================================
# URL вашего приложения на Vercel
# Используется для redirect URLs в платежах
WEBAPP_URL=https://your-app.vercel.app

# ============================================
# SUPABASE
# ============================================
# Database and Authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================
# GOOGLE / GEMINI AI
# ============================================
# For OCR and AI features
GOOGLE_API_KEY=your-google-api-key
GEMINI_API_KEY=your-gemini-api-key

# ============================================
# TELEGRAM BOT
# ============================================
# Telegram Bot Integration (optional, if not using - leave empty)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ============================================
# MAPS
# ============================================
# Yandex Maps API
YANDEX_MAPS_API_KEY=your-yandex-maps-api-key

# ============================================
# SMS / PHONE VERIFICATION
# ============================================
# SMS.RU API for phone verification
SMS_RU_API_ID=your-sms-ru-api-id

# ============================================
# VK AUTHENTICATION (optional)
# ============================================
# VK App ID for VK login integration
VK_APP_ID=your-vk-app-id

# ============================================
# YOOKASSA PAYMENTS
# ============================================
# Payment gateway credentials
YOOKASSA_SHOP_ID=your-yookassa-shop-id
YOOKASSA_SECRET_KEY=your-yookassa-secret-key

# ============================================
# EXTERNAL SERVICES
# ============================================
# Bot notification service (Render.com or other)
BOT_NOTIFY_URL=https://your-bot-server.onrender.com/notify

# OCR Worker service (Render.com or other)
OCR_WORKER_URL=https://your-ocr-worker.onrender.com

# Contracts/PDF generation service (Render.com or other)
CONTRACTS_API_URL=https://your-contracts-api.onrender.com

# ============================================
# SECURITY SECRETS
# ============================================
# Admin panel secret key
ADMIN_SECRET_KEY=your-admin-secret-key

# Internal API secret for service-to-service communication
INTERNAL_SECRET=your-internal-secret-key

# ============================================
# DEPLOYMENT INSTRUCTIONS
# ============================================
# 1. Rename this file to .env for local development
# 2. For Vercel deployment:
#    - Go to vercel.com → Your Project → Settings → Environment Variables
#    - Add each variable above
#    - Select environments: Production, Preview, Development
#    - Redeploy your project
#
# 3. For Android app (Capacitor):
#    - Update capacitor.config.json manually with your WEBAPP_URL
#
# 4. Never commit .env or site/config.js to git!
#    These files are in .gitignore

